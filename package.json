{
  "name": "electget",
  "version": "0.1.2",
  "description": "Electron tools for creating Windows widgets that are fixed to desktop.",
  "main": "dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.esm.json && tsc --project tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({ type: 'module' }))\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "electron",
    "always on bottom",
    "prevent showdesktop",
    "prevent aeropeek",
    "widget",
    "windows",
    "macOS",
    "koffi"
  ],
  "homepage": "https://github.com/lowfront/electget",
  "bugs": {
    "url": "https://github.com/lowfront/electget/issues"
  },
  "author": {
    "name": "lowfront",
    "email": "lowfronterior@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.3.1",
    "nswindow-napi": "0.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "^44.4.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "electron": ">=12"
  }
}
